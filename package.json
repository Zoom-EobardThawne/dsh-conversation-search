{
  "name": "dsh-conversation-search",
  "version": "0.1.0",
  "description": "In-conversation keyword search for DSH: find text in the current Session transcript, highlight every match, and jump to its exact position",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "src/client.js",
    "README.md",
    "INSTALL.md",
    "LICENSE"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.0-rc.1 <0.3.0-0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "check": "node scripts/check.mjs",
    "test": "node tests/engine.test.mjs",
    "pack:tarball": "node scripts/pack.mjs",
    "release": "node scripts/publish.mjs",
    "prepack": "node scripts/build-client.mjs && node scripts/check.mjs"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "conversation",
    "search",
    "find",
    "highlight"
  ],
  "author": "闲卧庭前远看帆",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zoom-EobardThawne/dsh-conversation-search.git"
  },
  "homepage": "https://github.com/Zoom-EobardThawne/dsh-conversation-search#readme",
  "bugs": {
    "url": "https://github.com/Zoom-EobardThawne/dsh-conversation-search/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
